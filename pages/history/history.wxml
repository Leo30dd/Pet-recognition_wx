<view class="container">
  <view class="page-title">识别历史</view>

  <block wx:if="{{historyList.length > 0}}">
    <!-- 遍历列表 -->
    <view class="history-item" wx:for="{{historyList}}" wx:key="id" 
          bindtap="goToDetail" data-breed="{{item.breed}}">
      
      <!-- 图片：使用后端返回的 image_url -->
      <image class="history-img" src="{{item.image_url}}" mode="aspectFill"></image>
      
      <!-- 信息 -->
      <view class="history-info">
        <view class="history-breed">{{item.breed}}</view>
        <view class="history-conf">置信度: {{item.confidence}}%</view>
        <view class="history-time">{{item.time}}</view>
      </view>
      
      <!-- 【删除按钮】 catchtap 阻止冒泡，点击它只删除，不跳转 -->
      <view class="delete-btn" catchtap="deleteItem" data-id="{{item.id}}">
        <text>✕</text>
      </view>
    </view>
    
    <button class="clear-btn" bindtap="clearHistory">清空历史记录</button>
  </block>

  <view wx:else class="empty-tip">暂无识别记录</view>
</view>