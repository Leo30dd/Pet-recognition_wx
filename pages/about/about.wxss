/* pages/about/about.wxss */
/* 全局背景 */
page {
  background-color: #f6f8fa;
  padding-bottom: 40rpx;
}

.container {
  padding: 30rpx;
}

.title-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* 1. 头部 Logo 区 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 0 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,122,255,0.1); /* 蓝色微弱阴影 */
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.version {
  font-size: 24rpx;
  color: #007aff;
  background-color: #e6f0ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #007aff; /* 蓝色竖条装饰 */
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  text-align: justify;
}

/* 技术标签云 */
.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: #007aff;
  background-color: #f0f7ff;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.15);
}

/* 作者信息行 */
.info-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  align-items: flex-start;
}
.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  color: #888;
  width: 100rpx;
  flex-shrink: 0;
}

.info-row .value {
  color: #333;
  font-weight: 500;
  flex: 1;
}

/* 底部版权 */
.footer {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 60rpx;
}