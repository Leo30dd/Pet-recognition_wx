      <view class="tag">ResNet50V2</view>
      <view class="tag">Transfer Learning (迁移学习)</view>
      <view class="tag">TensorFlow 2.x</view>
      <view class="tag">Flask Backend</view>
      <view class="tag">微信小程序原生开发</view>
      <view class="tag">Fine-tuning (深度微调)</view>
    </view>
  </view>

