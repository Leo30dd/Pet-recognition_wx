<!-- pages/index/index.wxml -->
<view class="container">
  
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <view class="nav-left"></view>
    <view class="nav-right">
      <view class="nav-item" bindtap="goToHistory">
        <image class="nav-icon-img" src="/pages/img/history.svg"></image>
        <text>历史</text>
      </view>
      <view class="nav-item" bindtap="goToAbout" style="margin-left: 20rpx;">
        <image class="nav-icon-img" src="/pages/img/about.svg"></image>
        <text>关于</text>
      </view>
    </view>
  </view>

  <view class="header">
    <view class="title">智能狗狗品种识别</view>
    <view class="subtitle">支持金毛、哈士奇等20种常见狗狗</view>
  </view>
    
  <!-- 图片上传与预览区域 -->
  <view class="uploader-wrapper" bindtap="chooseImage">
    <image wx:if="{{imageSrc}}" class="preview-image" src="{{imageSrc}}" mode="aspectFill"></image>
    <view wx:else class="uploader-placeholder">
      <image class="uploader-icon" src="/pages/img/camera.svg"></image>
      <text class="uploader-text">点击上传照片</text>
    </view>
  </view>

  <!-- 操作按钮区域 -->
  <view class="button-area">
    <button 
      wx:if="{{imageSrc}}" 
      type="primary" 
      bindtap="startRecognize" 
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      {{isLoading ? '识别中...' : '开始识别'}}
    </button>
  </view>

  <!-- 结果展示区域 -->
  <view wx:if="{{result}}" class="result-card" bindtap="goToDetail">
    <view class="result-header">
      <image class="result-icon" src="/pages/img/paw.svg"></image>
      <text class="result-title">识别结果</text>
    </view>
    
    <view class="result-body">
      <view class="result-item">
        <text class="result-label">预测品种</text>
        <text class="result-value breed">{{result.breed}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">置信度</text>
        <view class="confidence-bar">
          <view class="confidence-progress" style="width: {{result.confidence}}%;"></view>
          <text class="confidence-text">{{result.confidence}}%</text>
        </view>
      </view>
    </view>
    <view style="text-align: center; font-size: 22rpx; color: #999; margin-top: 20rpx;">
      点击查看 {{result.breed}} 百科详情 >
    </view>
  </view>

  <!-- 分享按钮 -->
  <button wx:if="{{result}}" open-type="share" style="margin-top: 30rpx; background-color: #07c160; color: white; border-radius: 50rpx; width: 690rpx;">
    分享给朋友
  </button>

  <view wx:if="{{errorMsg}}" class="error-tip">
    <text>{{errorMsg}}</text>
  </view>

</view>